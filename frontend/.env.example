# Copiar a .env (no se versiona). Ver vite.config.js.

# Vacío = rutas relativas (/api) que Vite reenvía al Gateway. Recomendado:
# funciona igual desde este equipo y desde otro de la red local.
VITE_API_URL=

# Interfaz de escucha de Vite: 0.0.0.0 = red local; localhost = solo este equipo.
VITE_HOST=0.0.0.0
VITE_PORT=5173

# Gateway al que se reenvía /api (el Gateway sigue solo en 127.0.0.1).
VITE_GATEWAY_TARGET=http://127.0.0.1:8888

# Nombres de equipo permitidos además de las IP (separados por coma), p. ej. PC-SECRETARIA
VITE_ALLOWED_HOSTS=

# Documentos legales del registro con correo (los publica la institución).
# Sin URL, el texto se muestra sin enlace. La versión queda registrada con la
# aceptación; vacía = "no-publicada".
VITE_TERMINOS_URL=
VITE_PRIVACIDAD_URL=
VITE_TERMINOS_VERSION=
