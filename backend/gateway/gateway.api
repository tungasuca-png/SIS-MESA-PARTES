syntax = "v1"

info (
	title:   "Mesa de Partes API Gateway"
	desc:    "API Gateway del sistema Mesa de Partes"
	version: "1.0"
)

type RegisterRequest {
	Username string `json:"username"`
	Dni      string `json:"dni"`
	Email    string `json:"email"`
	Password string `json:"password"`
	Role     string `json:"role,optional"`
}

type RegisterResponse {
	Id       string `json:"id"`
	Username string `json:"username"`
	Email    string `json:"email"`
	Role     string `json:"role"`
	Message  string `json:"message"`
}

type LoginRequest {
	Dni      string `json:"dni"`
	Password string `json:"password"`
}

type LoginResponse {
	AccessToken  string `json:"access_token"`
	RefreshToken string `json:"refresh_token"`
	ExpiresIn    int64  `json:"expires_in"`
	UserId       string `json:"user_id"`
	Username     string `json:"username"`
	Email        string `json:"email"`
	Role         string `json:"role"`
}

type RefreshTokenRequest {
	RefreshToken string `json:"refresh_token"`
}

type RefreshTokenResponse {
	AccessToken  string `json:"access_token"`
	RefreshToken string `json:"refresh_token"`
	ExpiresIn    int64  `json:"expires_in"`
}

type LogoutRequest {
	Authorization string `header:"Authorization,optional"`
	RefreshToken  string `json:"refresh_token"`
}

type LogoutResponse {
	Success bool   `json:"success"`
	Message string `json:"message"`
}

type ValidateTokenRequest {
	Authorization string `header:"Authorization,optional"`
}

// GetMyPermissions: lista de permisos efectivos del usuario AUTENTICADO
// (union de todos sus roles reales) — sin user_id en el request, a
// propósito: la identidad sale exclusivamente del JWT reenviado a Auth
// Service, nunca de un parámetro controlable por el cliente.
type GetMyPermissionsRequest {
	Authorization string `header:"Authorization,optional"`
}

type GetMyPermissionsResponse {
	Permissions []string `json:"permissions"`
}

type ValidateTokenResponse {
	Valid    bool   `json:"valid"`
	UserId   string `json:"user_id"`
	Username string `json:"username"`
	Role     string `json:"role"`
}

type ExpedienteDTO {
	Id                 string `json:"id"`
	Codigo             string `json:"codigo"`
	Tipo               string `json:"tipo"`
	Asunto             string `json:"asunto"`
	Descripcion        string `json:"descripcion"`
	SolicitanteId      string `json:"solicitante_id"`
	Estado             string `json:"estado"`
	Prioridad          string `json:"prioridad"`
	FechaRegistro      string `json:"fecha_registro"`
	FechaActualizacion string `json:"fecha_actualizacion"`
	Activo             bool   `json:"activo"`
	AreaActual         string `json:"area_actual"`
}

type CreateExpedienteRequest {
	Authorization string `header:"Authorization,optional"`
	Tipo          string `json:"tipo,optional"`
	Asunto        string `json:"asunto"`
	Descripcion   string `json:"descripcion,optional"`
	Prioridad     string `json:"prioridad,optional"`
}

type CreateExpedienteResponse {
	Expediente ExpedienteDTO `json:"expediente"`
}

type GetExpedienteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type GetExpedienteResponse {
	Expediente ExpedienteDTO `json:"expediente"`
}

type ListExpedientesRequest {
	Authorization string `header:"Authorization,optional"`
	Estado        string `form:"estado,optional"`
	Prioridad     string `form:"prioridad,optional"`
	Tipo          string `form:"tipo,optional"`
	Page          int32  `form:"page,optional"`
	PageSize      int32  `form:"page_size,optional"`
}

type ListExpedientesResponse {
	Expedientes []ExpedienteDTO `json:"expedientes"`
	Total       int32           `json:"total"`
}

type UpdateExpedienteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	Asunto        string `json:"asunto"`
	Descripcion   string `json:"descripcion,optional"`
	Prioridad     string `json:"prioridad,optional"`
}

type UpdateExpedienteResponse {
	Expediente ExpedienteDTO `json:"expediente"`
}

type DeleteExpedienteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type DeleteExpedienteResponse {
	Success bool `json:"success"`
}

type UpdateAreaRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	Area          string `json:"area"`
}

type UpdateAreaResponse {
	Expediente ExpedienteDTO `json:"expediente"`
}

type ChangeEstadoRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	NuevoEstado   string `json:"nuevo_estado"`
}

type ChangeEstadoResponse {
	Expediente ExpedienteDTO `json:"expediente"`
}

// DerivarExpediente (Etapa 3): operación de negocio real que reemplaza el
// patrón anterior del frontend (crear derivación + PATCH /area por
// separado, sin garantía de que ambas tuvieran éxito). El Gateway compone:
// primero Expedientes.DerivarExpediente (autoritativo — valida la
// transición y mueve area_actual), y solo si eso tuvo éxito, registra la
// derivación en Derivaciones Service como historial.
type DerivarExpedienteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	AreaDestino   string `json:"area_destino"`
	Motivo        string `json:"motivo"`
	Condicion     string `json:"condicion,optional"`
}

type DerivarExpedienteResponse {
	Expediente ExpedienteDTO `json:"expediente"`
	Derivacion DerivacionDTO `json:"derivacion"`
}

// Etapa 4: cierre real de F2/F4 — ver docs/etapa-4-resolucion-cierre-f2-f4.md.
// RechazarExpediente: Dirección o Subdirección rechazan un F4 y lo
// devuelven a Secretaría (OBSERVADO) para que el solicitante corrija. El
// Gateway compone igual que DerivarExpediente: primero mueve
// estado+área (autoritativo), luego registra el historial.
type RechazarExpedienteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	Motivo        string `json:"motivo"`
}

type RechazarExpedienteResponse {
	Expediente ExpedienteDTO `json:"expediente"`
	Derivacion DerivacionDTO `json:"derivacion"`
}

// CorregirExpediente: el solicitante corrige su propio expediente
// observado y vuelve a entrar a revisión (mismo expediente, mismo código).
type CorregirExpedienteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	Descripcion   string `json:"descripcion"`
}

type CorregirExpedienteResponse {
	Expediente ExpedienteDTO `json:"expediente"`
}

// ResolverExpediente: Secretaría cierra un F2 (ATENDIDO) una vez que
// existe el documento final — el Gateway verifica contra Documentos
// Service antes de llamar a Expedientes Service.
type ResolverExpedienteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type ResolverExpedienteResponse {
	Expediente ExpedienteDTO `json:"expediente"`
}

// ExportFutPdf: reconstruye el cargo del FUT como PDF vectorial real
// (texto con glifos, no una imagen rasterizada) a partir de los datos ya
// guardados en el propio expediente y en sus documentos reales — mismo
// dato que ya usaba el PDF generado en el navegador, solo que ahora el
// render ocurre en el backend con una librería de PDF en Go (mejor
// resolución al imprimir/hacer zoom, y el mismo archivo se ve igual sin
// depender del navegador de cada usuario).
type ExportFutPdfRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type ExportFutPdfResponse {
	Nombre          string `json:"nombre"`
	ContenidoBase64 string `json:"contenido_base64"`
}

service gateway-api {
	@handler Register
	post /api/auth/register (RegisterRequest) returns (RegisterResponse)

	@handler Login
	post /api/auth/login (LoginRequest) returns (LoginResponse)

	@handler RefreshToken
	post /api/auth/refresh (RefreshTokenRequest) returns (RefreshTokenResponse)

	@handler Logout
	post /api/auth/logout (LogoutRequest) returns (LogoutResponse)

	@handler ValidateToken
	get /api/auth/validate (ValidateTokenRequest) returns (ValidateTokenResponse)

	@handler GetMyPermissions
	get /api/auth/me/permissions (GetMyPermissionsRequest) returns (GetMyPermissionsResponse)
}

type UsuarioDTO {
	Id          string `json:"id"`
	Nombres     string `json:"nombres"`
	Apellidos   string `json:"apellidos"`
	Dni         string `json:"dni"`
	Telefono    string `json:"telefono"`
	Correo      string `json:"correo"`
	Direccion   string `json:"direccion"`
	TipoUsuario string `json:"tipo_usuario"`
	Activo      bool   `json:"activo"`
	CreatedAt   string `json:"created_at"`
	UpdatedAt   string `json:"updated_at"`
}

type UsuarioBasicDTO {
	Id             string `json:"id"`
	Nombres        string `json:"nombres"`
	Apellidos      string `json:"apellidos"`
	NombreCompleto string `json:"nombre_completo"`
	TipoUsuario    string `json:"tipo_usuario"`
	Dni            string `json:"dni"`
}

type GetUsuarioRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type GetUsuarioResponse {
	Usuario UsuarioDTO `json:"usuario"`
}

type GetUsuarioBasicRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type GetUsuarioBasicResponse {
	Usuario UsuarioBasicDTO `json:"usuario"`
}

type GetUsuariosBasicRequest {
	Authorization string   `header:"Authorization,optional"`
	Ids           []string `json:"ids"`
}

type GetUsuariosBasicResponse {
	Usuarios []UsuarioBasicDTO `json:"usuarios"`
}

type ListUsuariosRequest {
	Authorization string `header:"Authorization,optional"`
	Q             string `form:"q,optional"`
	TipoUsuario   string `form:"tipo_usuario,optional"`
	Page          int32  `form:"page,optional"`
	PageSize      int32  `form:"page_size,optional"`
}

type ListUsuariosResponse {
	Usuarios []UsuarioDTO `json:"usuarios"`
	Total    int32        `json:"total"`
}

// UpdateMyProfile (Paso 22E): edición del PROPIO perfil por el usuario
// autenticado — sin id/user_id en el request, a propósito: la identidad
// sale exclusivamente del JWT reenviado a Usuarios Service, nunca de un
// campo enviado por el cliente.
type UpdateMyProfileRequest {
	Authorization string `header:"Authorization,optional"`
	Telefono      string `json:"telefono,optional"`
	Correo        string `json:"correo,optional"`
	Direccion     string `json:"direccion,optional"`
}

type UpdateMyProfileResponse {
	Usuario UsuarioDTO `json:"usuario"`
}

// UpdateUserRole (Usuario -> Rol, administrativo): reemplaza el ÚNICO rol
// de un usuario existente. Distinto de PUT /api/roles/:id/permissions
// (Rol -> Permisos) — el :id de esta ruta es el usuario, no el rol.
type UpdateUserRoleRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	RoleId        string `json:"role_id"`
}

type UpdateUserRoleResponse {
	UserId     string `json:"user_id"`
	RoleId     string `json:"role_id"`
	RoleNombre string `json:"role_nombre"`
	// UsuariosSyncOk: Auth Service es la única fuente de verdad del rol (ya
	// confirmado arriba); esto solo informa si la copia denormalizada de
	// Usuarios Service (tipo_usuario, usada por GET /api/usuarios) quedó
	// sincronizada. false NUNCA significa que el rol no cambió — solo que
	// esa copia puede haber quedado desactualizada.
	UsuariosSyncOk bool `json:"usuarios_sync_ok"`
}

// CreateUsuario (administrativo): crea la identidad real en Auth Service
// (usuario + credenciales + rol único vía role_id) y sincroniza el perfil
// en Usuarios Service (UpsertUsuario, ya existente) usando el role_nombre
// que Auth YA confirmó — nunca un nombre de rol enviado por el frontend.
// Distinto de POST /api/auth/register (público, self-service, solo crea
// SOLICITANTE): esta ruta la protege "usuarios.change_role" (igual que
// PUT /api/usuarios/:id/rol) porque crear un usuario implica decidir su
// rol inicial.
type CreateUsuarioRequest {
	Authorization string `header:"Authorization,optional"`
	Username      string `json:"username"`
	Email         string `json:"email"`
	Password      string `json:"password"`
	RoleId        string `json:"role_id"`
	Nombres       string `json:"nombres"`
	Apellidos     string `json:"apellidos"`
	Dni           string `json:"dni"`
	Telefono      string `json:"telefono,optional"`
	Direccion     string `json:"direccion,optional"`
}

type CreateUsuarioResponse {
	Id         string `json:"id"`
	Username   string `json:"username"`
	Email      string `json:"email"`
	RoleId     string `json:"role_id"`
	RoleNombre string `json:"role_nombre"`
	// UsuariosSyncOk: mismo criterio ya usado por UpdateUserRoleResponse —
	// Auth Service ya creó la identidad real (fuente de verdad); esto solo
	// informa si el perfil de Usuarios Service (tipo_usuario/nombres/etc.,
	// usado por GET /api/usuarios) quedó sincronizado.
	UsuariosSyncOk bool `json:"usuarios_sync_ok"`
}

service gateway-api {
	@handler ListUsuarios
	get /api/usuarios (ListUsuariosRequest) returns (ListUsuariosResponse)

	@handler CreateUsuario
	post /api/usuarios (CreateUsuarioRequest) returns (CreateUsuarioResponse)

	@handler GetUsuariosBasic
	post /api/usuarios/basic-batch (GetUsuariosBasicRequest) returns (GetUsuariosBasicResponse)

	@handler GetUsuario
	get /api/usuarios/:id (GetUsuarioRequest) returns (GetUsuarioResponse)

	@handler GetUsuarioBasic
	get /api/usuarios/:id/basic (GetUsuarioBasicRequest) returns (GetUsuarioBasicResponse)

	@handler UpdateMyProfile
	put /api/usuarios/me (UpdateMyProfileRequest) returns (UpdateMyProfileResponse)

	@handler UpdateUserRole
	put /api/usuarios/:id/rol (UpdateUserRoleRequest) returns (UpdateUserRoleResponse)
}

service gateway-api {
	@handler CreateExpediente
	post /api/expedientes (CreateExpedienteRequest) returns (CreateExpedienteResponse)

	@handler ListExpedientes
	get /api/expedientes (ListExpedientesRequest) returns (ListExpedientesResponse)

	@handler GetExpediente
	get /api/expedientes/:id (GetExpedienteRequest) returns (GetExpedienteResponse)

	@handler UpdateExpediente
	put /api/expedientes/:id (UpdateExpedienteRequest) returns (UpdateExpedienteResponse)

	@handler ChangeEstado
	patch /api/expedientes/:id/estado (ChangeEstadoRequest) returns (ChangeEstadoResponse)

	@handler DeleteExpediente
	delete /api/expedientes/:id (DeleteExpedienteRequest) returns (DeleteExpedienteResponse)

	@handler UpdateArea
	patch /api/expedientes/:id/area (UpdateAreaRequest) returns (UpdateAreaResponse)

	@handler DerivarExpediente
	patch /api/expedientes/:id/derivar (DerivarExpedienteRequest) returns (DerivarExpedienteResponse)

	@handler RechazarExpediente
	patch /api/expedientes/:id/rechazar (RechazarExpedienteRequest) returns (RechazarExpedienteResponse)

	@handler CorregirExpediente
	patch /api/expedientes/:id/corregir (CorregirExpedienteRequest) returns (CorregirExpedienteResponse)

	@handler ResolverExpediente
	patch /api/expedientes/:id/resolver (ResolverExpedienteRequest) returns (ResolverExpedienteResponse)

	@handler ExportFutPdf
	get /api/expedientes/:id/fut-pdf (ExportFutPdfRequest) returns (ExportFutPdfResponse)
}

type DocumentoDTO {
	Id            string `json:"id"`
	ExpedienteId  string `json:"expediente_id"`
	Nombre        string `json:"nombre"`
	TipoDocumento string `json:"tipo_documento"`
	Extension     string `json:"extension"`
	TamanoBytes   int64  `json:"tamano_bytes"`
	SubidoPor     string `json:"subido_por"`
	Estado        string `json:"estado"`
	FechaRegistro string `json:"fecha_registro"`
}

type UploadDocumentoRequest {
	Authorization string `header:"Authorization,optional"`
	ExpedienteId  string `json:"expediente_id"`
	Nombre        string `json:"nombre"`
	TipoDocumento string `json:"tipo_documento"`
	Extension     string `json:"extension"`
	Contenido     string `json:"contenido"`
}

type UploadDocumentoResponse {
	Documento DocumentoDTO `json:"documento"`
}

type GetDocumentoRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type GetDocumentoResponse {
	Documento DocumentoDTO `json:"documento"`
}

type DownloadDocumentoRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type DownloadDocumentoResponse {
	Documento DocumentoDTO `json:"documento"`
	Contenido string       `json:"contenido"`
}

type ListDocumentosRequest {
	Authorization string `header:"Authorization,optional"`
	ExpedienteId  string `path:"expediente_id"`
}

type ListDocumentosResponse {
	Documentos []DocumentoDTO `json:"documentos"`
}

type ListAllDocumentosRequest {
	Authorization string `header:"Authorization,optional"`
	ExpedienteId  string `form:"expediente_id,optional"`
	TipoDocumento string `form:"tipo_documento,optional"`
	Page          int32  `form:"page,optional"`
	PageSize      int32  `form:"page_size,optional"`
}

type ListAllDocumentosResponse {
	Documentos []DocumentoDTO `json:"documentos"`
	Total      int32          `json:"total"`
}

type DeleteDocumentoRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type DeleteDocumentoResponse {
	Success bool `json:"success"`
}

service gateway-api {
	@handler UploadDocumento
	post /api/documentos (UploadDocumentoRequest) returns (UploadDocumentoResponse)

	@handler GetDocumento
	get /api/documentos/:id (GetDocumentoRequest) returns (GetDocumentoResponse)

	@handler DownloadDocumento
	get /api/documentos/:id/contenido (DownloadDocumentoRequest) returns (DownloadDocumentoResponse)

	@handler DeleteDocumento
	delete /api/documentos/:id (DeleteDocumentoRequest) returns (DeleteDocumentoResponse)

	@handler ListDocumentosByExpediente
	get /api/expedientes/:expediente_id/documentos (ListDocumentosRequest) returns (ListDocumentosResponse)

	@handler ListAllDocumentos
	get /api/documentos (ListAllDocumentosRequest) returns (ListAllDocumentosResponse)
}

type DerivacionDTO {
	Id            string `json:"id"`
	ExpedienteId  string `json:"expediente_id"`
	Tipo          string `json:"tipo"`
	Origen        string `json:"origen"`
	Destino       string `json:"destino"`
	Motivo        string `json:"motivo"`
	Condicion     string `json:"condicion"`
	RegistradoPor string `json:"registrado_por"`
	FechaRegistro string `json:"fecha_registro"`
}

type CrearDerivacionRequest {
	Authorization string `header:"Authorization,optional"`
	ExpedienteId  string `path:"expediente_id"`
	Tipo          string `json:"tipo"`
	Origen        string `json:"origen"`
	Destino       string `json:"destino"`
	Motivo        string `json:"motivo"`
	Condicion     string `json:"condicion,optional"`
}

type CrearDerivacionResponse {
	Derivacion DerivacionDTO `json:"derivacion"`
}

type GetDerivacionRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type GetDerivacionResponse {
	Derivacion DerivacionDTO `json:"derivacion"`
}

type ListDerivacionesByExpedienteRequest {
	Authorization string `header:"Authorization,optional"`
	ExpedienteId  string `path:"expediente_id"`
}

type ListDerivacionesResponse {
	Derivaciones []DerivacionDTO `json:"derivaciones"`
	Total        int32           `json:"total"`
}

type ListAllDerivacionesRequest {
	Authorization string `header:"Authorization,optional"`
	ExpedienteId  string `form:"expediente_id,optional"`
	Tipo          string `form:"tipo,optional"`
	Page          int32  `form:"page,optional"`
	PageSize      int32  `form:"page_size,optional"`
}

service gateway-api {
	@handler CrearDerivacion
	post /api/expedientes/:expediente_id/derivaciones (CrearDerivacionRequest) returns (CrearDerivacionResponse)

	@handler GetDerivacion
	get /api/derivaciones/:id (GetDerivacionRequest) returns (GetDerivacionResponse)

	@handler ListDerivacionesByExpediente
	get /api/expedientes/:expediente_id/derivaciones (ListDerivacionesByExpedienteRequest) returns (ListDerivacionesResponse)

	@handler ListAllDerivaciones
	get /api/derivaciones (ListAllDerivacionesRequest) returns (ListDerivacionesResponse)
}

// Paso 21D: exposición de solo transporte HTTP para los RPC de
// configuración de roles/permisos ya implementados en Auth Service (Pasos
// 21B/21C) — autenticación (JWT) y autorización ("roles.view") siguen
// resolviéndose por completo en Auth (ProtectedMethod), igual que el resto
// del Gateway: estos handlers son passthrough puro, sin ninguna regla de
// negocio ni chequeo de rol propio.
type RoleDTO {
	Id          string `json:"id"`
	Nombre      string `json:"nombre"`
	Descripcion string `json:"descripcion"`
	Estado      bool   `json:"estado"`
}

type PermissionDTO {
	Id          string `json:"id"`
	Codigo      string `json:"codigo"`
	Nombre      string `json:"nombre"`
	Descripcion string `json:"descripcion"`
	Modulo      string `json:"modulo"`
	Estado      bool   `json:"estado"`
}

type ListRolesRequest {
	Authorization string `header:"Authorization,optional"`
}

type ListRolesResponse {
	Roles []RoleDTO `json:"roles"`
}

type ListPermissionsRequest {
	Authorization string `header:"Authorization,optional"`
}

type ListPermissionsResponse {
	Permissions []PermissionDTO `json:"permissions"`
}

type GetRolePermissionsRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type GetRolePermissionsResponse {
	Permissions []PermissionDTO `json:"permissions"`
}

// UpdateRolePermissionsRequest.PermissionIds representa el conjunto FINAL
// de permisos del rol (reemplaza, no agrega) — un arreglo vacío es una
// entrada válida (el rol queda sin ningún permiso), ver
// Auth.UpdateRolePermissions.
type UpdateRolePermissionsRequest {
	Authorization string   `header:"Authorization,optional"`
	Id            string   `path:"id"`
	PermissionIds []string `json:"permission_ids"`
}

type UpdateRolePermissionsResponse {
	RoleId        string   `json:"role_id"`
	PermissionIds []string `json:"permission_ids"`
}

service gateway-api {
	@handler ListRoles
	get /api/roles (ListRolesRequest) returns (ListRolesResponse)

	@handler ListPermissions
	get /api/permissions (ListPermissionsRequest) returns (ListPermissionsResponse)

	@handler GetRolePermissions
	get /api/roles/:id/permissions (GetRolePermissionsRequest) returns (GetRolePermissionsResponse)

	@handler UpdateRolePermissions
	put /api/roles/:id/permissions (UpdateRolePermissionsRequest) returns (UpdateRolePermissionsResponse)
}

// Psicología (FASE 1): transporte HTTP puro hacia Psicología Service. Igual
// que el resto del Gateway: se reenvía el header Authorization y NO se valida
// ningún rol ni permiso aquí — JWT, Auth.HasPermission y el alcance de datos
// se resuelven por completo en Psicología Service.
type ExpedientePsicologicoDTO {
	Id            string `json:"id"`
	EstudianteId  string `json:"estudiante_id"`
	Codigo        string `json:"codigo"`
	Estado        string `json:"estado"`
	ResponsableId string `json:"responsable_id"`
	AbiertoPor    string `json:"abierto_por"`
	FechaApertura string `json:"fecha_apertura"`
	FechaCierre   string `json:"fecha_cierre"`
	MotivoCierre  string `json:"motivo_cierre"`
	ResumenCaso   string `json:"resumen_caso"`
	CreatedAt     string `json:"created_at"`
	UpdatedAt     string `json:"updated_at"`
}

type PsicologiaExpedienteResponse {
	Expediente ExpedientePsicologicoDTO `json:"expediente"`
}

type GetPsicologiaExpedienteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type GetPsicologiaExpedienteByEstudianteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type ListPsicologiaExpedientesRequest {
	Authorization string `header:"Authorization,optional"`
	Estado        string `form:"estado,optional"`
	Page          int32  `form:"page,optional"`
	PageSize      int32  `form:"page_size,optional"`
}

type ListPsicologiaExpedientesResponse {
	Expedientes []ExpedientePsicologicoDTO `json:"expedientes"`
	Total       int32                      `json:"total"`
}

type OpenPsicologiaExpedienteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	ResponsableId string `json:"responsable_id,optional"`
	ResumenCaso   string `json:"resumen_caso,optional"`
}

type UpdatePsicologiaExpedienteRequest {
	Authorization string  `header:"Authorization,optional"`
	Id            string  `path:"id"`
	ResumenCaso   *string `json:"resumen_caso,optional"`
	ResponsableId *string `json:"responsable_id,optional"`
	Estado        *string `json:"estado,optional"`
}

type ClosePsicologiaExpedienteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	Motivo        string `json:"motivo"`
}

type ReopenPsicologiaExpedienteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	Estado        string `json:"estado,optional"`
}

service gateway-api {
	@handler GetPsicologiaExpediente
	get /api/psicologia/expedientes/:id (GetPsicologiaExpedienteRequest) returns (PsicologiaExpedienteResponse)

	@handler GetPsicologiaExpedienteByEstudiante
	get /api/psicologia/estudiantes/:id/expediente (GetPsicologiaExpedienteByEstudianteRequest) returns (PsicologiaExpedienteResponse)

	@handler ListPsicologiaExpedientes
	get /api/psicologia/expedientes (ListPsicologiaExpedientesRequest) returns (ListPsicologiaExpedientesResponse)

	@handler OpenPsicologiaExpediente
	post /api/psicologia/estudiantes/:id/expediente (OpenPsicologiaExpedienteRequest) returns (PsicologiaExpedienteResponse)

	@handler UpdatePsicologiaExpediente
	put /api/psicologia/expedientes/:id (UpdatePsicologiaExpedienteRequest) returns (PsicologiaExpedienteResponse)

	@handler ClosePsicologiaExpediente
	put /api/psicologia/expedientes/:id/cerrar (ClosePsicologiaExpedienteRequest) returns (PsicologiaExpedienteResponse)

	@handler ReopenPsicologiaExpediente
	put /api/psicologia/expedientes/:id/reabrir (ReopenPsicologiaExpedienteRequest) returns (PsicologiaExpedienteResponse)
}

// Atenciones psicológicas (Hoja de Atención): transporte HTTP puro hacia
// Psicología Service, igual que los expedientes. Permisos
// (psicologia.atenciones.*), alcance del expediente, versionado, anulación,
// auditoría y generación del PDF se resuelven por completo en Psicología
// Service. El Gateway nunca registra el contenido (logsafe).
type AtencionContenidoDTO {
	FechaAtencion         string   `json:"fecha_atencion,optional"`
	HoraAtencion          string   `json:"hora_atencion,optional"`
	RealizadaPor          []string `json:"realizada_por,optional"`
	RealizadaPorOtros     string   `json:"realizada_por_otros,optional"`
	Motivos               []string `json:"motivos,optional"`
	MotivoOtros           string   `json:"motivo_otros,optional"`
	DescripcionMotivo     string   `json:"descripcion_motivo,optional"`
	AnalisisIntegral      string   `json:"analisis_integral,optional"`
	Estrategias           string   `json:"estrategias,optional"`
	Derivaciones          []string `json:"derivaciones,optional"`
	DerivacionOtro        string   `json:"derivacion_otro,optional"`
	SeguimientoResultados string   `json:"seguimiento_resultados,optional"`
	Acuerdos              string   `json:"acuerdos,optional"`
	CompromisoEstudiante  string   `json:"compromiso_estudiante,optional"`
	CompromisoFamilia     string   `json:"compromiso_familia,optional"`
}

type OpcionCatalogoDTO {
	Codigo   string `json:"codigo"`
	Etiqueta string `json:"etiqueta"`
}

type AtencionVersionDTO {
	NumeroVersion    int32                `json:"numero_version"`
	Contenido        AtencionContenidoDTO `json:"contenido"`
	Motivos          []OpcionCatalogoDTO  `json:"motivos"`
	Derivaciones     []OpcionCatalogoDTO  `json:"derivaciones"`
	MotivoCorreccion string               `json:"motivo_correccion"`
	CreadaPor        string               `json:"creada_por"`
	CreadaEn         string               `json:"creada_en"`
}

type AtencionPsicologicaDTO {
	Id              string             `json:"id"`
	ExpedienteId    string             `json:"expediente_id"`
	Numero          int32              `json:"numero"`
	Estado          string             `json:"estado"`
	AutorId         string             `json:"autor_id"`
	RegistradaPor   string             `json:"registrada_por"`
	RegistradaEn    string             `json:"registrada_en"`
	VersionVigente  int32              `json:"version_vigente"`
	Revision        int32              `json:"revision"`
	AnuladaPor      string             `json:"anulada_por"`
	AnuladaEn       string             `json:"anulada_en"`
	MotivoAnulacion string             `json:"motivo_anulacion"`
	CreatedAt       string             `json:"created_at"`
	UpdatedAt       string             `json:"updated_at"`
	Version         AtencionVersionDTO `json:"version"`
}

// AtencionResumenDTO: fila del listado, sin contenido clínico.
type AtencionResumenDTO {
	Id             string              `json:"id"`
	Numero         int32               `json:"numero"`
	Estado         string              `json:"estado"`
	FechaAtencion  string              `json:"fecha_atencion"`
	HoraAtencion   string              `json:"hora_atencion"`
	Motivos        []OpcionCatalogoDTO `json:"motivos"`
	AutorId        string              `json:"autor_id"`
	RegistradaPor  string              `json:"registrada_por"`
	RegistradaEn   string              `json:"registrada_en"`
	VersionVigente int32               `json:"version_vigente"`
}

type AtencionVersionResumenDTO {
	NumeroVersion    int32  `json:"numero_version"`
	MotivoCorreccion string `json:"motivo_correccion"`
	CreadaPor        string `json:"creada_por"`
	CreadaEn         string `json:"creada_en"`
}

type PsicologiaAtencionResponse {
	Atencion AtencionPsicologicaDTO `json:"atencion"`
}

type CreatePsicologiaAtencionRequest {
	Authorization string               `header:"Authorization,optional"`
	Id            string               `path:"id"`
	Contenido     AtencionContenidoDTO `json:"contenido,optional"`
}

type ListPsicologiaAtencionesRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	Estado        string `form:"estado,optional"`
	Page          int32  `form:"page,optional"`
	PageSize      int32  `form:"page_size,optional"`
}

type ListPsicologiaAtencionesResponse {
	Atenciones []AtencionResumenDTO `json:"atenciones"`
	Total      int32                `json:"total"`
}

type GetPsicologiaAtencionRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type UpdatePsicologiaAtencionDraftRequest {
	Authorization string               `header:"Authorization,optional"`
	Id            string               `path:"id"`
	Revision      int32                `json:"revision"`
	Contenido     AtencionContenidoDTO `json:"contenido"`
}

type RevisionPsicologiaAtencionRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	Revision      int32  `json:"revision"`
}

type DiscardPsicologiaAtencionResponse {}

type CorrectPsicologiaAtencionRequest {
	Authorization    string               `header:"Authorization,optional"`
	Id               string               `path:"id"`
	VersionBase      int32                `json:"version_base"`
	MotivoCorreccion string               `json:"motivo_correccion"`
	Contenido        AtencionContenidoDTO `json:"contenido"`
}

type ListPsicologiaAtencionVersionsResponse {
	Versiones []AtencionVersionResumenDTO `json:"versiones"`
}

type GetPsicologiaAtencionVersionRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	Version       int32  `path:"version"`
}

type AnnulPsicologiaAtencionRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	Motivo        string `json:"motivo"`
}

type ExportPsicologiaAtencionPdfRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	Version       int32  `form:"version,optional"`
}

// Mismo contrato que el FUT de Mesa de Partes ({nombre, contenido_base64}),
// pero generado en Psicología Service.
type ExportPsicologiaAtencionPdfResponse {
	Nombre          string `json:"nombre"`
	ContenidoBase64 string `json:"contenido_base64"`
}

service gateway-api {
	@handler ListPsicologiaAtenciones
	get /api/psicologia/expedientes/:id/atenciones (ListPsicologiaAtencionesRequest) returns (ListPsicologiaAtencionesResponse)

	@handler CreatePsicologiaAtencion
	post /api/psicologia/expedientes/:id/atenciones (CreatePsicologiaAtencionRequest) returns (PsicologiaAtencionResponse)

	@handler GetPsicologiaAtencion
	get /api/psicologia/atenciones/:id (GetPsicologiaAtencionRequest) returns (PsicologiaAtencionResponse)

	@handler UpdatePsicologiaAtencionDraft
	put /api/psicologia/atenciones/:id/borrador (UpdatePsicologiaAtencionDraftRequest) returns (PsicologiaAtencionResponse)

	@handler RegisterPsicologiaAtencion
	put /api/psicologia/atenciones/:id/registrar (RevisionPsicologiaAtencionRequest) returns (PsicologiaAtencionResponse)

	@handler DiscardPsicologiaAtencion
	put /api/psicologia/atenciones/:id/descartar (RevisionPsicologiaAtencionRequest) returns (DiscardPsicologiaAtencionResponse)

	@handler CorrectPsicologiaAtencion
	post /api/psicologia/atenciones/:id/versiones (CorrectPsicologiaAtencionRequest) returns (PsicologiaAtencionResponse)

	@handler ListPsicologiaAtencionVersions
	get /api/psicologia/atenciones/:id/versiones (GetPsicologiaAtencionRequest) returns (ListPsicologiaAtencionVersionsResponse)

	@handler GetPsicologiaAtencionVersion
	get /api/psicologia/atenciones/:id/versiones/:version (GetPsicologiaAtencionVersionRequest) returns (PsicologiaAtencionResponse)

	@handler AnnulPsicologiaAtencion
	put /api/psicologia/atenciones/:id/anular (AnnulPsicologiaAtencionRequest) returns (PsicologiaAtencionResponse)

	@handler ExportPsicologiaAtencionPdf
	get /api/psicologia/atenciones/:id/pdf (ExportPsicologiaAtencionPdfRequest) returns (ExportPsicologiaAtencionPdfResponse)
}

// Estudiantes (FASE 5B): transporte HTTP puro hacia Estudiantes Service.
// Igual que el resto del Gateway: se reenvía el header Authorization y NO se
// valida ningún permiso aquí — JWT y "estudiantes.view" (vía
// Auth.HasPermission) se resuelven por completo en Estudiantes Service. Sin
// dato de documento ni fecha de nacimiento en ningún DTO (el propio proto de
// Estudiantes Service no los expone).
type EstudianteDTO {
	Id              string `json:"id"`
	Codigo          string `json:"codigo"`
	Nombres         string `json:"nombres"`
	Apellidos       string `json:"apellidos"`
	Nivel           string `json:"nivel"`
	Grado           string `json:"grado"`
	Seccion         string `json:"seccion"`
	Turno           string `json:"turno"`
	EstadoMatricula string `json:"estado_matricula"`
	Version         int32  `json:"version"` // FASE E-05
}

// EstudianteBasicoDTO (FASE 5D): agrega numero_documento (DNI) — lo
// necesita el selector de estudiantes del frontend, para que quien busca
// confirme que eligió al estudiante correcto. Sigue sin fecha_nacimiento ni
// ningún otro dato del documento.
type EstudianteBasicoDTO {
	Id              string `json:"id"`
	Codigo          string `json:"codigo"`
	NombreCompleto  string `json:"nombre_completo"`
	Nivel           string `json:"nivel"`
	Grado           string `json:"grado"`
	Seccion         string `json:"seccion"`
	EstadoMatricula string `json:"estado_matricula"`
	NumeroDocumento string `json:"numero_documento"`
	// FASE E-04: identificación básica (sin datos personales ni sensibles).
	Nombres         string `json:"nombres"`
	Apellidos       string `json:"apellidos"`
	ApellidoPaterno string `json:"apellido_paterno"`
	ApellidoMaterno string `json:"apellido_materno"`
	CodigoSiagie    string `json:"codigo_siagie"`
	TipoDocumento   string `json:"tipo_documento"`
	Estado          string `json:"estado"`
	Turno           string `json:"turno"`
	Version         int32  `json:"version"` // FASE E-05
}

type GetEstudianteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type GetEstudianteResponse {
	Estudiante EstudianteDTO `json:"estudiante"`
}

type SearchEstudiantesRequest {
	Authorization string `header:"Authorization,optional"`
	Q             string `form:"q,optional"`
	Page          int32  `form:"page,optional"`
	PageSize      int32  `form:"page_size,optional"`
	// FASE E-04: filtros opcionales (vacío = sin filtro). estado es el del
	// registro (ACTIVO/INACTIVO), no el de matrícula.
	Estado  string `form:"estado,optional"`
	Nivel   string `form:"nivel,optional"`
	Grado   string `form:"grado,optional"`
	Seccion string `form:"seccion,optional"`
	Turno   string `form:"turno,optional"`
	// Etapa 6: apellidos (por defecto) | codigo | recientes.
	Orden string `form:"orden,optional"`
}

type SearchEstudiantesResponse {
	Estudiantes []EstudianteBasicoDTO `json:"estudiantes"`
	Total       int32                 `json:"total"`
}

type GetEstudiantesBasicRequest {
	Authorization string   `header:"Authorization,optional"`
	Ids           []string `json:"ids"`
}

type GetEstudiantesBasicResponse {
	Estudiantes []EstudianteBasicoDTO `json:"estudiantes"`
}

// FASE E-05 — escritura del maestro. Transporte HTTP puro: la autenticación
// (JWT), los permisos (estudiantes.create/update/change_estado vía
// Auth.HasPermission), las validaciones y la auditoría se resuelven en
// Estudiantes Service. El usuario que queda en la auditoría sale del JWT; la
// solicitud no tiene ningún campo para indicarlo.
type CreateEstudianteRequest {
	Authorization    string `header:"Authorization,optional"`
	Codigo           string `json:"codigo,optional"`
	CodigoSiagie     string `json:"codigo_siagie,optional"`
	TipoDocumento    string `json:"tipo_documento,optional"`
	NumeroDocumento  string `json:"numero_documento,optional"`
	Nombres          string `json:"nombres,optional"`
	ApellidoPaterno  string `json:"apellido_paterno,optional"`
	ApellidoMaterno  string `json:"apellido_materno,optional"`
	Apellidos        string `json:"apellidos,optional"`
	FechaNacimiento  string `json:"fecha_nacimiento,optional"`
	Sexo             string `json:"sexo,optional"`
	PaisNacimiento   string `json:"pais_nacimiento,optional"`
	UbigeoNacimiento string `json:"ubigeo_nacimiento,optional"`
	LenguaMaterna    string `json:"lengua_materna,optional"`
	SegundaLengua    string `json:"segunda_lengua,optional"`
	FotoRef          string `json:"foto_ref,optional"`
	Estado           string `json:"estado,optional"`
}

// UpdateEstudianteRequest: PATCH parcial — un campo ausente no cambia; un
// campo presente con "" lo deja vacío (NULL). Por eso son punteros.
type UpdateEstudianteRequest {
	Authorization    string  `header:"Authorization,optional"`
	Id               string  `path:"id"`
	ExpectedVersion  int32   `json:"expected_version,optional"`
	CodigoSiagie     *string `json:"codigo_siagie,optional"`
	TipoDocumento    *string `json:"tipo_documento,optional"`
	NumeroDocumento  *string `json:"numero_documento,optional"`
	Nombres          *string `json:"nombres,optional"`
	ApellidoPaterno  *string `json:"apellido_paterno,optional"`
	ApellidoMaterno  *string `json:"apellido_materno,optional"`
	Apellidos        *string `json:"apellidos,optional"`
	FechaNacimiento  *string `json:"fecha_nacimiento,optional"`
	Sexo             *string `json:"sexo,optional"`
	PaisNacimiento   *string `json:"pais_nacimiento,optional"`
	UbigeoNacimiento *string `json:"ubigeo_nacimiento,optional"`
	LenguaMaterna    *string `json:"lengua_materna,optional"`
	SegundaLengua    *string `json:"segunda_lengua,optional"`
	FotoRef          *string `json:"foto_ref,optional"`
}

type ChangeEstadoEstudianteRequest {
	Authorization   string `header:"Authorization,optional"`
	Id              string `path:"id"`
	ExpectedVersion int32  `json:"expected_version,optional"`
	Estado          string `json:"estado,optional"`
}

// Las respuestas de escritura devuelven solo el registro BÁSICO.
type EstudianteWriteResponse {
	Estudiante EstudianteBasicoDTO `json:"estudiante"`
}

// FASE E-08 — DATOS PERSONALES (dominio separado). Transporte puro: permisos
// (estudiantes.personal.view/.update), validación, versión y auditoría se
// resuelven en Estudiantes Service. Solo seis campos; nunca foto_ref,
// identidad, estado ni datos académicos. "" = no registrado.
type EstudiantePersonalDTO {
	Id               string `json:"id"`
	Version          int32  `json:"version"`
	FechaNacimiento  string `json:"fecha_nacimiento"`
	Sexo             string `json:"sexo"`
	PaisNacimiento   string `json:"pais_nacimiento"`
	UbigeoNacimiento string `json:"ubigeo_nacimiento"`
	LenguaMaterna    string `json:"lengua_materna"`
	SegundaLengua    string `json:"segunda_lengua"`
	// Modelo maestro, etapa 2: domicilio vigente y contacto (dominio personal).
	DomicilioDireccion    string `json:"domicilio_direccion"`
	DomicilioDepartamento string `json:"domicilio_departamento"`
	DomicilioProvincia    string `json:"domicilio_provincia"`
	DomicilioDistrito     string `json:"domicilio_distrito"`
	DomicilioUbigeo       string `json:"domicilio_ubigeo"`
	Correo                string `json:"correo"`
	Telefono              string `json:"telefono"`
	// Edad calculada a la fecha de referencia (null si no se puede calcular).
	Edad *int32 `json:"edad"`
}

type GetEstudiantePersonalRequest {
	Authorization   string `header:"Authorization,optional"`
	Id              string `path:"id"`
	FechaReferencia string `form:"fecha_referencia,optional"`
}

type GetEstudiantePersonalResponse {
	Personal EstudiantePersonalDTO `json:"personal"`
}

// PATCH parcial: ausente (nil) = no cambia; "" = se deja vacío.
type UpdateEstudiantePersonalRequest {
	Authorization         string  `header:"Authorization,optional"`
	Id                    string  `path:"id"`
	ExpectedVersion       int32   `json:"expected_version,optional"`
	FechaNacimiento       *string `json:"fecha_nacimiento,optional"`
	Sexo                  *string `json:"sexo,optional"`
	PaisNacimiento        *string `json:"pais_nacimiento,optional"`
	UbigeoNacimiento      *string `json:"ubigeo_nacimiento,optional"`
	LenguaMaterna         *string `json:"lengua_materna,optional"`
	SegundaLengua         *string `json:"segunda_lengua,optional"`
	DomicilioDireccion    *string `json:"domicilio_direccion,optional"`
	DomicilioDepartamento *string `json:"domicilio_departamento,optional"`
	DomicilioProvincia    *string `json:"domicilio_provincia,optional"`
	DomicilioDistrito     *string `json:"domicilio_distrito,optional"`
	DomicilioUbigeo       *string `json:"domicilio_ubigeo,optional"`
	Correo                *string `json:"correo,optional"`
	Telefono              *string `json:"telefono,optional"`
}

// ---- Modelo maestro: resolución exacta y posibles duplicados ----
// Resolución por código O por tipo + número de documento (exactos). POST:
// el documento viaja en el cuerpo, nunca en la URL ni en logs de acceso.
type ResolveEstudianteRequest {
	Authorization   string `header:"Authorization,optional"`
	Codigo          string `json:"codigo,optional"`
	TipoDocumento   string `json:"tipo_documento,optional"`
	NumeroDocumento string `json:"numero_documento,optional"`
	CodigoSiagie    string `json:"codigo_siagie,optional"`
}

type ResolveEstudianteResponse {
	Estudiante EstudianteBasicoDTO `json:"estudiante"`
}

type GrupoPosibleDuplicadoDTO {
	Criterio    string                `json:"criterio"`
	Estudiantes []EstudianteBasicoDTO `json:"estudiantes"`
}

type ListPosiblesDuplicadosRequest {
	Authorization string `header:"Authorization,optional"`
	Page          int32  `form:"page,optional"`
	PageSize      int32  `form:"page_size,optional"`
}

type ListPosiblesDuplicadosResponse {
	Grupos []GrupoPosibleDuplicadoDTO `json:"grupos"`
	Total  int32                      `json:"total"`
}

// ---- Modelo maestro: matrícula (solo lectura) ----
type PeriodoAcademicoDTO {
	Id          string `json:"id"`
	Anio        int32  `json:"anio"`
	Nombre      string `json:"nombre"`
	Estado      string `json:"estado"`
	FechaInicio string `json:"fecha_inicio"`
	FechaFin    string `json:"fecha_fin"`
}

type SeccionAcademicaDTO {
	Id           string `json:"id"`
	PeriodoId    string `json:"periodo_id"`
	Nivel        string `json:"nivel"`
	Grado        string `json:"grado"`
	Seccion      string `json:"seccion"`
	Turno        string `json:"turno"`
	Aula         string `json:"aula"`
	Vacantes     *int32 `json:"vacantes"`
	Matriculados int32  `json:"matriculados"`
}

type MovimientoMatriculaDTO {
	Tipo              string `json:"tipo"`
	Fecha             string `json:"fecha"`
	SeccionAnteriorId string `json:"seccion_anterior_id"`
	SeccionNuevaId    string `json:"seccion_nueva_id"`
}

type MatriculaDTO {
	Id              string                   `json:"id"`
	EstudianteId    string                   `json:"estudiante_id"`
	Periodo         PeriodoAcademicoDTO      `json:"periodo"`
	Seccion         *SeccionAcademicaDTO     `json:"seccion"`
	EstadoMatricula string                   `json:"estado_matricula"`
	FechaMatricula  string                   `json:"fecha_matricula"`
	FechaRetiro     string                   `json:"fecha_retiro"`
	Origen          string                   `json:"origen"`
	Version         int32                    `json:"version"`
	Movimientos     []MovimientoMatriculaDTO `json:"movimientos"`
}

type ListMatriculasEstudianteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
}

type ListMatriculasEstudianteResponse {
	Matriculas []MatriculaDTO `json:"matriculas"`
}

// ---- Modelo maestro: familia (permisos estudiantes.familia.*) ----
type PersonaDTO {
	Id              string `json:"id"`
	TipoDocumento   string `json:"tipo_documento"`
	NumeroDocumento string `json:"numero_documento"`
	Nombres         string `json:"nombres"`
	ApellidoPaterno string `json:"apellido_paterno"`
	ApellidoMaterno string `json:"apellido_materno"`
	Version         int32  `json:"version"`
}

type PersonaInputDTO {
	TipoDocumento   string `json:"tipo_documento,optional"`
	NumeroDocumento string `json:"numero_documento,optional"`
	Nombres         string `json:"nombres,optional"`
	ApellidoPaterno string `json:"apellido_paterno,optional"`
	ApellidoMaterno string `json:"apellido_materno,optional"`
}

type FamiliarDTO {
	RelacionId  string     `json:"relacion_id"`
	Persona     PersonaDTO `json:"persona"`
	Parentesco  string     `json:"parentesco"`
	EsApoderado bool       `json:"es_apoderado"`
	Vigente     bool       `json:"vigente"`
	Desde       string     `json:"desde"`
	Hasta       string     `json:"hasta"`
}

type ListFamiliaresEstudianteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	Historial     bool   `form:"historial,optional"`
}

type ListFamiliaresEstudianteResponse {
	Familiares []FamiliarDTO `json:"familiares"`
}

type VincularFamiliarRequest {
	Authorization string           `header:"Authorization,optional"`
	Id            string           `path:"id"`
	PersonaId     string           `json:"persona_id,optional"`
	Persona       *PersonaInputDTO `json:"persona,optional"`
	Parentesco    string           `json:"parentesco,optional"`
	EsApoderado   bool             `json:"es_apoderado,optional"`
	Desde         string           `json:"desde,optional"`
}

type DesvincularFamiliarRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	RelacionId    string `path:"relacion_id"`
	Hasta         string `json:"hasta,optional"`
}

type FamiliarResponse {
	Familiar FamiliarDTO `json:"familiar"`
}

// ---- Etapa 5: transporte puro hacia Estudiantes Service. Permisos
// (estudiantes.view, estudiantes.familia.*, estudiantes.matricula.update),
// validación, versión y auditoría se resuelven allá. ----
// Solo el rol de apoderado de una relación vigente (es_apoderado obligatorio).
type ActualizarFamiliarRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	RelacionId    string `path:"relacion_id"`
	EsApoderado   bool   `json:"es_apoderado"`
}

type CreatePersonaRequest {
	Authorization string          `header:"Authorization,optional"`
	Persona       PersonaInputDTO `json:"persona"`
}

type PersonaResponse {
	Persona PersonaDTO `json:"persona"`
}

type GetPersonaRequest {
	Authorization string `header:"Authorization,optional"`
	PersonaId     string `path:"persona_id"`
	Historial     bool   `form:"historial,optional"`
}

type VinculoPersonaDTO {
	RelacionId  string               `json:"relacion_id"`
	Estudiante  *EstudianteBasicoDTO `json:"estudiante"`
	Parentesco  string               `json:"parentesco"`
	EsApoderado bool                 `json:"es_apoderado"`
	Vigente     bool                 `json:"vigente"`
	Desde       string               `json:"desde"`
	Hasta       string               `json:"hasta"`
}

type GetPersonaResponse {
	Persona  PersonaDTO          `json:"persona"`
	Vinculos []VinculoPersonaDTO `json:"vinculos"`
}

type SearchPersonasRequest {
	Authorization string `header:"Authorization,optional"`
	Q             string `form:"q,optional"`
	Page          int32  `form:"page,optional"`
	PageSize      int32  `form:"page_size,optional"`
}

type SearchPersonasResponse {
	Personas []PersonaDTO `json:"personas"`
	Total    int32        `json:"total"`
}

// PATCH parcial: ausente = no cambia; "" = NULL (punteros).
type UpdatePersonaRequest {
	Authorization   string  `header:"Authorization,optional"`
	PersonaId       string  `path:"persona_id"`
	ExpectedVersion int32   `json:"expected_version,optional"`
	TipoDocumento   *string `json:"tipo_documento,optional"`
	NumeroDocumento *string `json:"numero_documento,optional"`
	Nombres         *string `json:"nombres,optional"`
	ApellidoPaterno *string `json:"apellido_paterno,optional"`
	ApellidoMaterno *string `json:"apellido_materno,optional"`
}

type CreatePeriodoRequest {
	Authorization string `header:"Authorization,optional"`
	Anio          int32  `json:"anio,optional"`
	Nombre        string `json:"nombre,optional"`
	FechaInicio   string `json:"fecha_inicio,optional"`
	FechaFin      string `json:"fecha_fin,optional"`
}

type PeriodoResponse {
	Periodo PeriodoAcademicoDTO `json:"periodo"`
}

type ListPeriodosRequest {
	Authorization string `header:"Authorization,optional"`
}

type ListPeriodosResponse {
	Periodos []PeriodoAcademicoDTO `json:"periodos"`
}

type ChangeEstadoPeriodoRequest {
	Authorization string `header:"Authorization,optional"`
	PeriodoId     string `path:"periodo_id"`
	Estado        string `json:"estado,optional"`
}

type CreateSeccionRequest {
	Authorization string `header:"Authorization,optional"`
	PeriodoId     string `path:"periodo_id"`
	Nivel         string `json:"nivel,optional"`
	Grado         string `json:"grado,optional"`
	Seccion       string `json:"seccion,optional"`
	Turno         string `json:"turno,optional"`
	Aula          string `json:"aula,optional"`
	Vacantes      *int32 `json:"vacantes,optional"`
}

type SeccionResponse {
	Seccion SeccionAcademicaDTO `json:"seccion"`
}

type ListSeccionesRequest {
	Authorization string `header:"Authorization,optional"`
	PeriodoId     string `path:"periodo_id"`
}

type ListSeccionesResponse {
	Secciones []SeccionAcademicaDTO `json:"secciones"`
}

type MatriculaResponse {
	Matricula MatriculaDTO `json:"matricula"`
}

type MatricularEstudianteRequest {
	Authorization  string `header:"Authorization,optional"`
	Id             string `path:"id"`
	PeriodoId      string `json:"periodo_id,optional"`
	SeccionId      string `json:"seccion_id,optional"`
	FechaMatricula string `json:"fecha_matricula,optional"`
}

type CambiarSeccionMatriculaRequest {
	Authorization   string `header:"Authorization,optional"`
	MatriculaId     string `path:"matricula_id"`
	ExpectedVersion int32  `json:"expected_version,optional"`
	SeccionId       string `json:"seccion_id,optional"`
	Fecha           string `json:"fecha,optional"`
	Motivo          string `json:"motivo,optional"`
}

// tipo: RETIRO | TRASLADO.
type RetirarMatriculaRequest {
	Authorization   string `header:"Authorization,optional"`
	MatriculaId     string `path:"matricula_id"`
	ExpectedVersion int32  `json:"expected_version,optional"`
	Tipo            string `json:"tipo,optional"`
	Fecha           string `json:"fecha,optional"`
	Motivo          string `json:"motivo,optional"`
}

type ReingresarMatriculaRequest {
	Authorization   string `header:"Authorization,optional"`
	MatriculaId     string `path:"matricula_id"`
	ExpectedVersion int32  `json:"expected_version,optional"`
	Fecha           string `json:"fecha,optional"`
	Motivo          string `json:"motivo,optional"`
}

type ConcluirMatriculaRequest {
	Authorization   string `header:"Authorization,optional"`
	MatriculaId     string `path:"matricula_id"`
	ExpectedVersion int32  `json:"expected_version,optional"`
	Fecha           string `json:"fecha,optional"`
}

type ListMatriculasPeriodoRequest {
	Authorization   string `header:"Authorization,optional"`
	PeriodoId       string `path:"periodo_id"`
	SeccionId       string `form:"seccion_id,optional"`
	EstadoMatricula string `form:"estado_matricula,optional"`
	Page            int32  `form:"page,optional"`
	PageSize        int32  `form:"page_size,optional"`
}

// ---- Etapa 6: parentesco con historial e historial de cambios ----
type CambiarParentescoFamiliarRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	RelacionId    string `path:"relacion_id"`
	Parentesco    string `json:"parentesco,optional"`
	Desde         string `json:"desde,optional"`
}

type CambiarParentescoFamiliarResponse {
	Anterior FamiliarDTO `json:"anterior"`
	Familiar FamiliarDTO `json:"familiar"`
}

type ListHistorialEstudianteRequest {
	Authorization string `header:"Authorization,optional"`
	Id            string `path:"id"`
	Page          int32  `form:"page,optional"`
	PageSize      int32  `form:"page_size,optional"`
}

// Solo nombres de campos: nunca valores anteriores ni nuevos.
type EventoHistorialDTO {
	Id                string   `json:"id"`
	Accion            string   `json:"accion"`
	FechaHora         string   `json:"fecha_hora"`
	UsuarioId         string   `json:"usuario_id"`
	Campos            []string `json:"campos"`
	EstadoAnterior    string   `json:"estado_anterior"`
	EstadoNuevo       string   `json:"estado_nuevo"`
	VersionResultante int32    `json:"version_resultante"`
}

type ListHistorialEstudianteResponse {
	Eventos []EventoHistorialDTO `json:"eventos"`
	Total   int32                `json:"total"`
}

// Importación/exportación Excel de estudiantes (formato oficial de 9
// columnas). Los archivos viajan en base64 dentro de JSON, igual que el PDF
// del FUT; la carga del archivo a importar es multipart/form-data (campo
// "archivo"; en la confirmación, además "huella"), leída por el handler.
type ExcelEstudiantesRequest {
	Authorization string `header:"Authorization,optional"`
}

type ExportarEstudiantesExcelRequest {
	Authorization string `header:"Authorization,optional"`
	Estado        string `form:"estado,optional"`
	Nivel         string `form:"nivel,optional"`
}

type ArchivoExcelResponse {
	Nombre          string `json:"nombre"`
	ContenidoBase64 string `json:"contenido_base64"`
	Filas           int32  `json:"filas"`
}

type FilaImportacionDTO {
	Fila            int32    `json:"fila"`
	TipoDocumento   string   `json:"tipo_documento"`
	NumeroDocumento string   `json:"numero_documento"`
	ApellidoPaterno string   `json:"apellido_paterno"`
	ApellidoMaterno string   `json:"apellido_materno"`
	Nombres         string   `json:"nombres"`
	Estado          string   `json:"estado"`
	Nivel           string   `json:"nivel"`
	Resultado       string   `json:"resultado"`
	Errores         []string `json:"errores"`
	Avisos          []string `json:"avisos"`
}

type ResumenImportacionDTO {
	Total      int32 `json:"total"`
	Validas    int32 `json:"validas"`
	ConErrores int32 `json:"con_errores"`
	Duplicadas int32 `json:"duplicadas"`
	YaExisten  int32 `json:"ya_existen"`
	Insertadas int32 `json:"insertadas"`
	Omitidas   int32 `json:"omitidas"`
	Rechazadas int32 `json:"rechazadas"`
	ConAvisos  int32 `json:"con_avisos"`
}

type ImportarEstudiantesExcelResponse {
	Resumen    ResumenImportacionDTO `json:"resumen"`
	Filas      []FilaImportacionDTO  `json:"filas"`
	Huella     string                `json:"huella"`
	Confirmada bool                  `json:"confirmada"`
}

type MatriculaNominaDTO {
	Matricula  MatriculaDTO         `json:"matricula"`
	Estudiante *EstudianteBasicoDTO `json:"estudiante"`
}

type ListMatriculasPeriodoResponse {
	Matriculas []MatriculaNominaDTO `json:"matriculas"`
	Total      int32                `json:"total"`
}

service gateway-api {
	@handler SearchEstudiantes
	get /api/estudiantes (SearchEstudiantesRequest) returns (SearchEstudiantesResponse)

	@handler GetEstudiantesBasic
	post /api/estudiantes/basic-batch (GetEstudiantesBasicRequest) returns (GetEstudiantesBasicResponse)

	@handler GetEstudiante
	get /api/estudiantes/:id (GetEstudianteRequest) returns (GetEstudianteResponse)

	// FASE E-05: escritura del maestro (sin DELETE: no hay borrado físico).
	@handler CreateEstudiante
	post /api/estudiantes (CreateEstudianteRequest) returns (EstudianteWriteResponse)

	@handler UpdateEstudiante
	patch /api/estudiantes/:id (UpdateEstudianteRequest) returns (EstudianteWriteResponse)

	@handler ChangeEstadoEstudiante
	patch /api/estudiantes/:id/estado (ChangeEstadoEstudianteRequest) returns (EstudianteWriteResponse)

	// FASE E-08: datos personales.
	@handler GetEstudiantePersonal
	get /api/estudiantes/:id/personal (GetEstudiantePersonalRequest) returns (GetEstudiantePersonalResponse)

	@handler UpdateEstudiantePersonal
	patch /api/estudiantes/:id/personal (UpdateEstudiantePersonalRequest) returns (EstudianteWriteResponse)

	// Modelo maestro.
	@handler ResolveEstudiante
	post /api/estudiantes/resolver (ResolveEstudianteRequest) returns (ResolveEstudianteResponse)

	@handler ListPosiblesDuplicados
	get /api/estudiantes/duplicados (ListPosiblesDuplicadosRequest) returns (ListPosiblesDuplicadosResponse)

	@handler ListMatriculasEstudiante
	get /api/estudiantes/:id/matriculas (ListMatriculasEstudianteRequest) returns (ListMatriculasEstudianteResponse)

	@handler ListFamiliaresEstudiante
	get /api/estudiantes/:id/familiares (ListFamiliaresEstudianteRequest) returns (ListFamiliaresEstudianteResponse)

	@handler VincularFamiliar
	post /api/estudiantes/:id/familiares (VincularFamiliarRequest) returns (FamiliarResponse)

	@handler DesvincularFamiliar
	patch /api/estudiantes/:id/familiares/:relacion_id/desvincular (DesvincularFamiliarRequest) returns (FamiliarResponse)

	// Etapa 5: apoderado y personas.
	@handler ActualizarFamiliar
	patch /api/estudiantes/:id/familiares/:relacion_id (ActualizarFamiliarRequest) returns (FamiliarResponse)

	@handler SearchPersonas
	get /api/estudiantes/personas (SearchPersonasRequest) returns (SearchPersonasResponse)

	@handler CreatePersona
	post /api/estudiantes/personas (CreatePersonaRequest) returns (PersonaResponse)

	@handler GetPersona
	get /api/estudiantes/personas/:persona_id (GetPersonaRequest) returns (GetPersonaResponse)

	@handler UpdatePersona
	patch /api/estudiantes/personas/:persona_id (UpdatePersonaRequest) returns (PersonaResponse)

	// Etapa 5: periodos, secciones y matrículas (sin DELETE: nada se borra).
	@handler ListPeriodos
	get /api/estudiantes/periodos (ListPeriodosRequest) returns (ListPeriodosResponse)

	@handler CreatePeriodo
	post /api/estudiantes/periodos (CreatePeriodoRequest) returns (PeriodoResponse)

	@handler ChangeEstadoPeriodo
	patch /api/estudiantes/periodos/:periodo_id/estado (ChangeEstadoPeriodoRequest) returns (PeriodoResponse)

	@handler ListSecciones
	get /api/estudiantes/periodos/:periodo_id/secciones (ListSeccionesRequest) returns (ListSeccionesResponse)

	@handler CreateSeccion
	post /api/estudiantes/periodos/:periodo_id/secciones (CreateSeccionRequest) returns (SeccionResponse)

	@handler ListMatriculasPeriodo
	get /api/estudiantes/periodos/:periodo_id/matriculas (ListMatriculasPeriodoRequest) returns (ListMatriculasPeriodoResponse)

	@handler MatricularEstudiante
	post /api/estudiantes/:id/matriculas (MatricularEstudianteRequest) returns (MatriculaResponse)

	@handler CambiarSeccionMatricula
	patch /api/estudiantes/matriculas/:matricula_id/seccion (CambiarSeccionMatriculaRequest) returns (MatriculaResponse)

	@handler RetirarMatricula
	patch /api/estudiantes/matriculas/:matricula_id/retiro (RetirarMatriculaRequest) returns (MatriculaResponse)

	@handler ReingresarMatricula
	patch /api/estudiantes/matriculas/:matricula_id/reingreso (ReingresarMatriculaRequest) returns (MatriculaResponse)

	@handler ConcluirMatricula
	patch /api/estudiantes/matriculas/:matricula_id/conclusion (ConcluirMatriculaRequest) returns (MatriculaResponse)

	// Etapa 6.
	@handler CambiarParentescoFamiliar
	post /api/estudiantes/:id/familiares/:relacion_id/parentesco (CambiarParentescoFamiliarRequest) returns (CambiarParentescoFamiliarResponse)

	@handler ListHistorialEstudiante
	get /api/estudiantes/:id/historial (ListHistorialEstudianteRequest) returns (ListHistorialEstudianteResponse)
}

// ===== Motor universal de datos (importación/exportación multiformato) =====
type DatosCamposRequest {
	Authorization string `header:"Authorization,optional"`
}

type CampoDatosDTO {
	Clave      string `json:"clave"`
	Etiqueta   string `json:"etiqueta"`
	Grupo      string `json:"grupo"`
	Importable bool   `json:"importable"`
	Exportable bool   `json:"exportable"`
}

type ColumnaExportDatosDTO {
	Clave      string `json:"clave"`
	Encabezado string `json:"encabezado,optional"`
}

type DatosCamposResponse {
	Campos          []CampoDatosDTO         `json:"campos"`
	FormatosEntrada []string                `json:"formatos_entrada"`
	FormatosSalida  []string                `json:"formatos_salida"`
	ColumnasTabla   []ColumnaExportDatosDTO `json:"columnas_tabla"`
}

// Carga multipart: campo "archivo" + campo "solicitud" (JSON con opciones,
// mapeo y decisiones), leídos por el handler.
type DatosArchivoRequest {
	Authorization string `header:"Authorization,optional"`
}

type ColumnaAnalizadaDTO {
	Columna      int32    `json:"columna"`
	Encabezado   string   `json:"encabezado"`
	Campo        string   `json:"campo"`
	Confianza    string   `json:"confianza"`
	Motivo       string   `json:"motivo"`
	Alternativas []string `json:"alternativas"`
	Muestras     []string `json:"muestras"`
	Confirmada   bool     `json:"confirmada"`
	Importable   bool     `json:"importable"`
}

type RegistroAnalizadoDTO {
	Fila         int32    `json:"fila"`
	Categoria    string   `json:"categoria"`
	Codigo       string   `json:"codigo"`
	Documento    string   `json:"documento"`
	Apellidos    string   `json:"apellidos"`
	Nombres      string   `json:"nombres"`
	Estado       string   `json:"estado"`
	Nivel        string   `json:"nivel"`
	Grado        string   `json:"grado"`
	Seccion      string   `json:"seccion"`
	Turno        string   `json:"turno"`
	Errores      []string `json:"errores"`
	Avisos       []string `json:"avisos"`
	Correcciones []string `json:"correcciones"`
	Coincidencia string   `json:"coincidencia"`
	Resultado    string   `json:"resultado"`
}

type ResumenDatosDTO {
	Total        int32 `json:"total"`
	Nuevos       int32 `json:"nuevos"`
	Existentes   int32 `json:"existentes"`
	Duplicados   int32 `json:"duplicados"`
	PorConfirmar int32 `json:"por_confirmar"`
	Conflictos   int32 `json:"conflictos"`
	Invalidos    int32 `json:"invalidos"`
	ConAvisos    int32 `json:"con_avisos"`
	Insertados   int32 `json:"insertados"`
	Omitidos     int32 `json:"omitidos"`
}

type DatosImportacionResponse {
	Formato                string                 `json:"formato"`
	Extension              string                 `json:"extension"`
	Hojas                  []string               `json:"hojas"`
	Hoja                   string                 `json:"hoja"`
	Rutas                  []string               `json:"rutas"`
	Ruta                   string                 `json:"ruta"`
	Separador              string                 `json:"separador"`
	Codificacion           string                 `json:"codificacion"`
	FilaEncabezado         int32                  `json:"fila_encabezado"`
	AvisosArchivo          []string               `json:"avisos_archivo"`
	Columnas               []ColumnaAnalizadaDTO  `json:"columnas"`
	ProblemasMapeo         []string               `json:"problemas_mapeo"`
	RequiereConfirmarMapeo bool                   `json:"requiere_confirmar_mapeo"`
	Bloqueantes            []string               `json:"bloqueantes"`
	Avisos                 []string               `json:"avisos"`
	Resumen                ResumenDatosDTO        `json:"resumen"`
	Registros              []RegistroAnalizadoDTO `json:"registros"`
	Huella                 string                 `json:"huella"`
	Confirmada             bool                   `json:"confirmada"`
	PlantillaAplicada      string                 `json:"plantilla_aplicada"`
	PlantillaAvisos        []string               `json:"plantilla_avisos"`
}

type DatosExportarRequest {
	Authorization    string                  `header:"Authorization,optional"`
	Q                string                  `json:"q,optional"`
	Estado           string                  `json:"estado,optional"`
	Nivel            string                  `json:"nivel,optional"`
	Grado            string                  `json:"grado,optional"`
	Seccion          string                  `json:"seccion,optional"`
	Turno            string                  `json:"turno,optional"`
	Orden            string                  `json:"orden,optional"`
	Columnas         []ColumnaExportDatosDTO `json:"columnas,optional"`
	Formato          string                  `json:"formato,optional"`
	Separador        string                  `json:"separador,optional"`
	Codificacion     string                  `json:"codificacion,optional"`
	ProtegerFormulas bool                    `json:"proteger_formulas,optional"`
}

type ArchivoDatosResponse {
	Nombre          string `json:"nombre"`
	Mime            string `json:"mime"`
	ContenidoBase64 string `json:"contenido_base64"`
	Filas           int32  `json:"filas"`
	Protegidas      int32  `json:"protegidas"`
}

type PlantillaDatosDTO {
	Id             string `json:"id"`
	Tipo           string `json:"tipo"`
	Nombre         string `json:"nombre"`
	Formato        string `json:"formato"`
	Configuracion  string `json:"configuracion"`
	Version        int32  `json:"version"`
	CreadoPor      string `json:"creado_por"`
	ActualizadoPor string `json:"actualizado_por"`
	Creado         string `json:"creado"`
	Actualizado    string `json:"actualizado"`
}

type ListPlantillasDatosRequest {
	Authorization string `header:"Authorization,optional"`
	Tipo          string `form:"tipo,optional"`
}

type ListPlantillasDatosResponse {
	Plantillas []PlantillaDatosDTO `json:"plantillas"`
}

type GuardarPlantillaDatosRequest {
	Authorization   string `header:"Authorization,optional"`
	Id              string `json:"id,optional"`
	Tipo            string `json:"tipo"`
	Nombre          string `json:"nombre"`
	Formato         string `json:"formato,optional"`
	Configuracion   string `json:"configuracion"`
	ExpectedVersion int32  `json:"expected_version,optional"`
}

type PlantillaDatosResponse {
	Plantilla PlantillaDatosDTO `json:"plantilla"`
}

type EliminarPlantillaDatosRequest {
	Authorization string `header:"Authorization,optional"`
	PlantillaId   string `path:"plantilla_id"`
	Tipo          string `json:"tipo"`
}

type EliminarPlantillaDatosResponse {
	Eliminada bool `json:"eliminada"`
}

// Excel de estudiantes: validar o registrar cientos de filas supera el tiempo
// HTTP por defecto (3 s); el servicio tiene hasta 180 s para confirmar.
@server (
	timeout: 190s
)
service gateway-api {
	// Excel: plantilla, importación en dos etapas y exportación.
	@handler PlantillaEstudiantesExcel
	get /api/estudiantes/importacion/plantilla (ExcelEstudiantesRequest) returns (ArchivoExcelResponse)

	@handler PreviewImportacionEstudiantes
	post /api/estudiantes/importacion/preview (ExcelEstudiantesRequest) returns (ImportarEstudiantesExcelResponse)

	@handler ConfirmarImportacionEstudiantes
	post /api/estudiantes/importacion/confirmar (ExcelEstudiantesRequest) returns (ImportarEstudiantesExcelResponse)

	@handler ExportarEstudiantesExcel
	get /api/estudiantes/exportar (ExportarEstudiantesExcelRequest) returns (ArchivoExcelResponse)
}

// Motor universal de datos: carga de archivos (hasta 3 MB; el cuerpo
// multipart, 4 MB) y confirmación de cientos de registros.
@server (
	timeout:  190s
	maxBytes: 4194304
)
service gateway-api {
	@handler AnalizarDatosEstudiantes
	post /api/estudiantes/datos/analizar (DatosArchivoRequest) returns (DatosImportacionResponse)

	@handler ConfirmarDatosEstudiantes
	post /api/estudiantes/datos/confirmar (DatosArchivoRequest) returns (DatosImportacionResponse)
}

@server (
	timeout: 70s
)
service gateway-api {
	@handler CamposDatosEstudiantes
	get /api/estudiantes/datos/campos (DatosCamposRequest) returns (DatosCamposResponse)

	@handler ExportarDatosEstudiantes
	post /api/estudiantes/datos/exportar (DatosExportarRequest) returns (ArchivoDatosResponse)

	@handler ListPlantillasDatos
	get /api/estudiantes/datos/plantillas (ListPlantillasDatosRequest) returns (ListPlantillasDatosResponse)

	@handler GuardarPlantillaDatos
	post /api/estudiantes/datos/plantillas (GuardarPlantillaDatosRequest) returns (PlantillaDatosResponse)

	@handler EliminarPlantillaDatos
	post /api/estudiantes/datos/plantillas/:plantilla_id/eliminar (EliminarPlantillaDatosRequest) returns (EliminarPlantillaDatosResponse)
}

