# Copiar a ".env" (en esta misma carpeta) y completar los valores reales.
# ".env" y ".env.*" están en .gitignore: NUNCA versionar valores reales.
# run-all.ps1 carga todas estas variables; si "JWT_SECRET" no está o el
# archivo no existe, genera uno nuevo y lo guarda en ".env".

# Secreto de firma de los access tokens. Mismo valor para todos los servicios
# (Auth firma; los demás validan). Generar con 32 bytes aleatorios; rotarlo
# invalida todas las sesiones.
JWT_SECRET=

# Clave de firma de los tokens de SISTEMAS consumidores (client credentials).
# Solo la usan Auth (firma) y Estudiantes (valida); debe ser DISTINTA de
# JWT_SECRET y de al menos 32 caracteres. Vacía = autenticación de sistemas
# deshabilitada (el login de usuarios no cambia). Nunca se entrega a los
# sistemas consumidores: ellos reciben client_id + client_secret.
SERVICE_JWT_SECRET=

# Contraseñas de los roles de APLICACIÓN de PostgreSQL (mínimo privilegio, ver
# backend/db/roles/README.md). Los YAML las leen como ${<SERVICIO>_DB_PASSWORD}.
AUTH_DB_PASSWORD=
PSICOLOGIA_DB_PASSWORD=
ESTUDIANTES_DB_PASSWORD=
EXPEDIENTES_DB_PASSWORD=
DOCUMENTOS_DB_PASSWORD=
DERIVACIONES_DB_PASSWORD=
USUARIOS_DB_PASSWORD=

# Cifrado del contenido clínico de Psicología (AES-256-GCM). Sin una clave
# válida que descifre su canario, Psicología NO inicia. La clave (base64 de 32
# bytes aleatorios) debe tener además una copia bajo custodia institucional:
# si se pierde, las atenciones cifradas son irrecuperables.
CLINICAL_DATA_ENCRYPTION_KEY=
CLINICAL_DATA_KEY_ID=
# Solo durante una rotación: claves anteriores para descifrar, "id:clave,id:clave".
CLINICAL_DATA_PREVIOUS_KEYS=

# Credencial de Psicología como sistema consumidor de Estudiantes (client
# credentials, permiso estudiantes.basic.view). Se obtienen al registrar el
# sistema "Servicio Psicologia" con services/auth/cmd/clientes-servicio; el
# secreto se muestra una sola vez. OBLIGATORIAS: sin ellas Psicología no inicia.
PSICOLOGIA_CLIENT_ID=
PSICOLOGIA_CLIENT_SECRET=
# Solo desarrollo (Mode dev o test): "true" permite arrancar sin las
# credenciales reenviando el JWT del usuario (necesita estudiantes.view). En
# cualquier otro Mode impide el arranque. Por defecto, false.
PSICOLOGIA_ALLOW_LEGACY_AUTH=false

# Carpeta FUERA del repositorio con los secretos de administración
# (pg_admin_user, pg_admin_password, migrators.env). La usa
# docker-compose.dev.yml; no es un secreto en sí.
TG_SECRETS_DIR=

# Las credenciales de PRUEBA (TEST_<SERVICIO>_DB_URL) van en ".env.test",
# también fuera de Git. Sin ellas, las pruebas de integración se omiten.

# --- Acceso con Google (OpenID Connect), solo SOLICITANTES ---
# Credenciales del cliente OAuth "Aplicación web" de Google Cloud Console.
# Sin ellas el botón "Continuar con Google" responde "no habilitado" y el
# login con DNI y clave sigue igual. Nunca versionar los valores reales.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con una "Authorized redirect URI" del cliente.
# Desarrollo (proxy de Vite): http://localhost:5173/api/auth/google/callback
# Producción: https://<dominio-real>/api/auth/google/callback
GOOGLE_REDIRECT_URL=http://localhost:5173/api/auth/google/callback
# Vacío = https://accounts.google.com
GOOGLE_OIDC_ISSUER=
# Origen del frontend para las redirecciones; vacío = mismo origen que el Gateway.
FRONTEND_URL=
# true en producción (HTTPS): cookies del flujo con el atributo Secure.
GOOGLE_COOKIE_SECURE=false

# --- Registro manual con verificación de correo (solo SOLICITANTES) ---
# Proveedor SMTP institucional o transaccional (nunca un Gmail personal).
# Sin SMTP_SERVIDOR y SMTP_REMITENTE el registro manual queda deshabilitado
# ("no disponible"); el login y Google no cambian. Nunca versionar valores reales.
# SMTP_SERVIDOR: host:puerto (p. ej. smtp.proveedor.example:587).
SMTP_SERVIDOR=
SMTP_USUARIO=
SMTP_CLAVE=
# Dirección remitente autorizada por el proveedor (SPF/DKIM del dominio).
SMTP_REMITENTE=
SMTP_NOMBRE_REMITENTE=SIS-MESA-PARTES - I.E. Tungasuca
# starttls (587, por defecto) | tls (465) | ninguna (solo un servidor local de
# pruebas como Mailpit en 127.0.0.1:1025; con otro host Auth no arranca).
SMTP_SEGURIDAD=starttls

# ---------------------------------------------------------------------------
# A + B (movimientos, outbox y proyección). Valores SOLO aquí, nunca en YAML.
# Secreto de firma EXCLUSIVO de la audiencia derivaciones (Auth y Derivaciones),
# >= 32 caracteres, distinto de JWT_SECRET y de SERVICE_JWT_SECRET.
SERVICE_JWT_SECRET_DERIVACIONES=
# Contraseñas de los roles de una sola función (db/roles/01_roles.sql).
EXPEDIENTES_PUBLICADOR_DB_PASSWORD=
DERIVACIONES_PROYECTOR_DB_PASSWORD=
# Cliente de servicio del publicador (CreateServiceClient con audiencia
# derivaciones y permiso derivaciones.proyectar; el secreto se muestra una vez).
# Sin estos valores Expedientes NO arranca (Publicador.Habilitado: true).
EXPEDIENTES_PUBLICADOR_CLIENT_ID=
EXPEDIENTES_PUBLICADOR_CLIENT_SECRET=
# Reconciliación diaria D8 (rol reconciliador_movimientos). Los DSN van SIN
# contraseña (el programa se niega a correr si la incluyen).
RECONCILIADOR_EXPEDIENTES_DSN=postgres://reconciliador_movimientos@127.0.0.1:5432/expedientes_db?sslmode=disable
RECONCILIADOR_DERIVACIONES_DSN=postgres://reconciliador_movimientos@127.0.0.1:5432/derivaciones_db?sslmode=disable
RECONCILIADOR_DB_PASSWORD=
# Alertas por correo de D8 (opcional; sin servidor solo hay log y código de salida).
RECONCILIADOR_SMTP_SERVIDOR=
RECONCILIADOR_SMTP_USUARIO=
RECONCILIADOR_SMTP_CLAVE=
RECONCILIADOR_SMTP_REMITENTE=
RECONCILIADOR_SMTP_DESTINATARIOS=
