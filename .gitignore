# Variables de entorno
.env
.env.*
!.env.example

# Go
*.exe
*.test
*.out
vendor/

# Logs
*.log
logs/

# VS Code
.vscode/

# Sistema operativo
.DS_Store
Thumbs.db

# Archivos temporales
*.tmp
*.temp
# Dependencias sueltas en la raíz (no pertenecen a ninguna app; el frontend
# tiene su propio package.json/node_modules en frontend/)
/node_modules/
/package.json
/package-lock.json

# Configuración local de Claude Code (personal, no se comparte)
.claude/settings.local.json

# Respaldos de bases de datos: contienen datos personales y hashes de
# contraseñas. Se guardan fuera del repositorio (~/.tungasuca-backups).
backups/
*.dump

# Prevención: claves, certificados, respaldos y datos tabulares (pueden
# contener credenciales o datos personales). Las migraciones .sql, la
# documentación y los .env.example NO se ven afectados.
*.pem
*.key
*.backup
*.xlsx
*.csv
# Configuración local de servicios (backend/services/*/etc/*.local.yaml)
**/etc/*.local.yaml
